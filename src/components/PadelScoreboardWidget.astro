---
import { accentClasses } from '../data/site';
import { DEFAULT_COLORS, DEFAULT_NAMES } from '../lib/padel';

const teams = DEFAULT_COLORS.map((color, index) => ({
  name: DEFAULT_NAMES[index],
  color: accentClasses(color),
}));

const setNumbers = [1, 2, 3, 4, 5];

const secondaryButton =
  'rounded-full border border-zinc-300 px-4 py-2 text-sm font-medium text-zinc-700 transition hover:border-zinc-500 disabled:cursor-not-allowed disabled:opacity-40 dark:border-zinc-700 dark:text-zinc-200 dark:hover:border-zinc-500';
const labelText = 'text-sm font-medium text-zinc-600 dark:text-zinc-400';
const selectClass =
  'rounded-lg border border-zinc-300 bg-white px-3 py-2 text-base text-zinc-900 focus:border-zinc-500 focus:outline-none disabled:cursor-not-allowed disabled:opacity-50 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100';
const summaryClass =
  'cursor-pointer list-none px-4 py-3 text-sm font-medium text-zinc-700 dark:text-zinc-300 [&::-webkit-details-marker]:hidden';
const panelClass =
  'space-y-4 border-t border-zinc-200 px-4 py-4 dark:border-zinc-800';
---

<div
  data-padel
  class="rounded-2xl border border-zinc-200 bg-zinc-50 p-4 dark:border-zinc-800 dark:bg-zinc-900/50 sm:p-6"
>
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <p class="text-xs font-medium uppercase tracking-wide text-zinc-500 dark:text-zinc-400">
        Match
      </p>
      <p data-mode-label class="mt-0.5 text-sm font-medium text-zinc-700 dark:text-zinc-300">
        Best of 3 · Golden point
      </p>
    </div>
    <div class="flex items-center gap-2">
      <span
        data-clock
        aria-label="Match time"
        class="font-mono text-2xl font-bold tabular-nums tracking-tight text-zinc-900 dark:text-zinc-100"
      >
        00:00
      </span>
      <button type="button" data-clock-toggle class={secondaryButton}>Start</button>
    </div>
  </div>

  <p
    data-notice
    role="status"
    class="mt-3 hidden rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800 dark:border-amber-900 dark:bg-amber-950/40 dark:text-amber-200"
  >
  </p>

  <div
    class="mt-4 overflow-hidden rounded-xl border border-zinc-200 bg-white dark:border-zinc-800 dark:bg-zinc-900/60"
  >
    <div class="overflow-x-auto">
      <table class="w-full table-fixed border-collapse text-center text-sm">
        <caption class="sr-only">Padel scoreboard</caption>
        <colgroup>
          <col />
          <col data-set-col="0" class="w-6 sm:w-10" />
          <col data-set-col="1" class="hidden w-6 sm:w-10" />
          <col data-set-col="2" class="hidden w-6 sm:w-10" />
          <col data-set-col="3" class="hidden w-6 sm:w-10" />
          <col data-set-col="4" class="hidden w-6 sm:w-10" />
          <col data-sets-col class="w-8 sm:w-12" />
          <col data-points-col class="w-12 sm:w-20" />
        </colgroup>
        <thead>
          <tr
            class="border-b border-zinc-200 text-[11px] uppercase tracking-wide text-zinc-500 dark:border-zinc-800 dark:text-zinc-400"
          >
            <th scope="col" class="px-2 py-2 text-left font-medium sm:px-3">Team</th>
            {
              setNumbers.map((number, index) => (
                <th
                  scope="col"
                  data-set-head={index}
                  class:list={[
                    'px-0.5 py-2 font-medium',
                    index > 0 && 'hidden',
                    index === 0 && 'bg-zinc-50 text-zinc-900 dark:bg-zinc-800/40 dark:text-zinc-100',
                  ]}
                >
                  <span aria-hidden="true">{number}</span>
                  <span class="sr-only">Set {number}</span>
                </th>
              ))
            }
            <th scope="col" data-sets-head class="px-1 py-2 font-medium">Sets</th>
            <th scope="col" data-points-head class="px-1 py-2 font-medium">
              <span aria-hidden="true">Pts</span>
              <span class="sr-only">Points</span>
            </th>
          </tr>
        </thead>
        <tbody>
          {
            [0, 1].map((index) => (
              <tr class="border-b border-zinc-100 last:border-0 dark:border-zinc-800/70">
                <th scope="row" class="px-2 py-3 text-left sm:px-3">
                  <div class="flex items-center gap-1.5">
                    <button
                      type="button"
                      data-color={index}
                      aria-label={`Change ${teams[index].name} color`}
                      title="Change color"
                      class:list={[
                        'h-3 w-3 shrink-0 rounded-full ring-1 ring-zinc-300 ring-offset-1 transition hover:ring-zinc-500 dark:ring-zinc-700 dark:ring-offset-zinc-900',
                        teams[index].color.bg,
                      ]}
                    ></button>
                    <input
                      type="text"
                      data-name={index}
                      value={teams[index].name}
                      maxlength="24"
                      autocomplete="off"
                      spellcheck="false"
                      aria-label={`Team ${index + 1} name`}
                      class:list={[
                        'min-w-0 w-full border-b border-transparent bg-transparent px-0 py-0.5 text-sm font-semibold focus:border-zinc-400 focus:outline-none dark:focus:border-zinc-500',
                        teams[index].color.text,
                      ]}
                    />
                    <span
                      data-serve={index}
                      class:list={[
                        'shrink-0 text-xs text-emerald-500',
                        index === 1 && 'hidden',
                      ]}
                      title="Serving"
                      aria-hidden="true"
                    >
                      ●
                    </span>
                  </div>
                </th>
                {
                  setNumbers.map((_, setIndex) => (
                    <td
                      data-set-cell={`${index}-${setIndex}`}
                      class:list={[
                        'px-0.5 py-3 text-lg font-medium tabular-nums',
                        setIndex === 0
                          ? 'bg-zinc-50 font-semibold dark:bg-zinc-800/40'
                          : 'hidden',
                      ]}
                    >
                      {setIndex === 0 ? '0' : '–'}
                    </td>
                  ))
                }
                <td data-sets-won={index} class="px-1 py-3 text-lg font-semibold tabular-nums">
                  0
                </td>
                <td
                  data-points={index}
                  class:list={[
                    'px-1 py-3 text-3xl font-bold tabular-nums sm:text-4xl',
                    teams[index].color.text,
                  ]}
                >
                  0
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>

  <p
    data-status
    class="mt-3 text-center text-sm font-medium text-zinc-700 dark:text-zinc-300"
  >
    Team 1 to serve
  </p>
  <p data-live class="sr-only" aria-live="polite"></p>

  <div
    data-result
    class="mt-3 hidden rounded-xl border border-zinc-200 bg-white p-4 text-center dark:border-zinc-800 dark:bg-zinc-900/60"
  >
    <p data-result-title class="text-lg font-semibold"></p>
    <p data-result-detail class="mt-1 text-sm text-zinc-600 dark:text-zinc-400"></p>
  </div>

  <div class="mt-4 grid grid-cols-2 gap-3">
    {
      [0, 1].map((index) => (
        <button
          type="button"
          data-point={index}
          class:list={[
            'flex flex-col items-center justify-center rounded-xl border-2 border-current px-3 py-3 text-sm font-semibold shadow-sm transition hover:opacity-80 focus:outline-none focus-visible:ring-2 focus-visible:ring-zinc-400 disabled:cursor-not-allowed disabled:opacity-40',
            teams[index].color.bgSoft,
            teams[index].color.text,
          ]}
        >
          <span class="text-[11px] font-medium uppercase tracking-wide opacity-80">Point</span>
          <span data-point-name={index} class="mt-0.5 max-w-full truncate text-base">
            {teams[index].name}
          </span>
        </button>
      ))
    }
  </div>

  <div class="mt-4 flex flex-wrap items-center gap-2">
    <button type="button" data-undo class={secondaryButton} disabled>Undo</button>
    <button type="button" data-copy-result class={secondaryButton}>Copy result</button>
    <button type="button" data-new class={secondaryButton}>New match</button>
  </div>
  <p class="mt-2 text-xs text-zinc-500 dark:text-zinc-400">
    Keys: 1 and 2 add a point, U undoes the last one.
  </p>

  <details
    data-settings
    class="mt-3 rounded-xl border border-zinc-200 bg-white dark:border-zinc-800 dark:bg-zinc-900/60"
  >
    <summary class={summaryClass}>Match settings</summary>
    <div class={panelClass}>
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="flex flex-col gap-1">
          <span class={labelText}>Match type</span>
          <select data-mode class={selectClass}>
            <option value="full" selected>Full match</option>
            <option value="tiebreak">Tie-break only</option>
          </select>
        </label>
        <label data-full-setting class="flex flex-col gap-1">
          <span class={labelText}>Best of</span>
          <select data-best-of class={selectClass}>
            <option value="1">Single set</option>
            <option value="3" selected>Best of 3</option>
            <option value="5">Best of 5</option>
          </select>
        </label>
        <label data-full-setting class="flex flex-col gap-1">
          <span class={labelText}>At 40-40</span>
          <select data-scoring class={selectClass}>
            <option value="golden" selected>Golden point</option>
            <option value="advantage">Advantage</option>
          </select>
        </label>
        <label class="flex flex-col gap-1">
          <span class={labelText}>First serve</span>
          <select data-first-server class={selectClass}>
            <option value="0" selected>Team 1</option>
            <option value="1">Team 2</option>
          </select>
        </label>
      </div>
      <p data-tiebreak-note class="hidden text-xs text-zinc-500 dark:text-zinc-400">
        The tie-break is played to 7 points, with a two-point lead.
      </p>
      <label class="flex items-center gap-2 text-sm text-zinc-600 dark:text-zinc-400">
        <input
          type="checkbox"
          data-wake
          class="h-4 w-4 rounded border-zinc-300 text-amber-600 focus:ring-amber-500 dark:border-zinc-700 dark:bg-zinc-900"
        />
        Keep the screen on
      </label>
      <p data-wake-note class="hidden text-xs text-zinc-500 dark:text-zinc-400"></p>
      <p data-settings-lock class="hidden text-xs text-zinc-500 dark:text-zinc-400">
        Settings are locked once the match starts. Use New match to change the format.
      </p>
    </div>
  </details>

  <details
    data-share
    class="mt-3 rounded-xl border border-zinc-200 bg-white dark:border-zinc-800 dark:bg-zinc-900/60"
  >
    <summary class={summaryClass}>Share</summary>
    <div class={panelClass}>
      <label class="flex items-start gap-2 text-sm text-zinc-700 dark:text-zinc-300">
        <input
          type="checkbox"
          data-include-names
          class="mt-0.5 h-4 w-4 rounded border-zinc-300 text-amber-600 focus:ring-amber-500 dark:border-zinc-700 dark:bg-zinc-900"
        />
        <span>
          <span class="font-medium">Include team names in the link</span>
          <span class="mt-0.5 block text-xs text-zinc-500 dark:text-zinc-400">
            Names are not encrypted. They travel in the URL and may appear in browser
            history or chat previews.
          </span>
        </span>
      </label>
      <p class="text-xs text-zinc-500 dark:text-zinc-400">
        The link is a snapshot of the score at this moment. Copy a new one after the next
        point.
      </p>
      <button
        type="button"
        data-copy-link
        class="rounded-full bg-zinc-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-zinc-800 dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-zinc-200"
      >
        Copy match link
      </button>
    </div>
  </details>
</div>

<script>
  import '../scripts/padelScoreboard';
</script>

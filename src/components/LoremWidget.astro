---
import { accentClasses, type AccentName } from '../data/site';
import { generateLorem } from '../lib/lorem';

interface Props {
  accent?: AccentName;
}

const { accent = 'sky' } = Astro.props;
const accentColor = accentClasses(accent).text;

const initial = generateLorem({
  units: 'paragraphs',
  count: 3,
  seed: 12345,
  startWithLorem: true,
});

const inputClass =
  'rounded-lg border border-zinc-300 bg-white px-3 py-2 text-sm text-zinc-900 focus:border-zinc-500 focus:outline-none dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100';
const labelClass = 'flex flex-col gap-1 text-sm font-medium text-zinc-600 dark:text-zinc-400';
---

<div
  data-lorem-widget
  class="rounded-2xl border border-zinc-200 bg-zinc-50 p-6 dark:border-zinc-800 dark:bg-zinc-900/50"
>
  <div class="flex flex-wrap items-end gap-4">
    <label class={labelClass}>
      <span>Units</span>
      <select data-units-select class={inputClass}>
        <option value="paragraphs">Paragraphs</option>
        <option value="sentences">Sentences</option>
        <option value="words">Words</option>
      </select>
    </label>
    <label class={labelClass}>
      <span>How many</span>
      <input type="number" min="1" max="100" step="1" data-count-input value="3" class={inputClass} />
    </label>
    <label class={labelClass}>
      <span>Seed</span>
      <input type="number" step="1" data-seed-input value="12345" class={inputClass} />
    </label>
    <label class="flex items-center gap-2 pb-2 text-sm font-medium text-zinc-600 dark:text-zinc-400">
      <input type="checkbox" data-lorem-checkbox checked class="h-4 w-4" />
      <span>Start with “Lorem ipsum”</span>
    </label>
    <button
      type="button"
      data-reseed
      class="mb-0.5 rounded-full border border-zinc-300 px-4 py-2 text-sm font-medium transition hover:border-zinc-500 dark:border-zinc-700 dark:hover:border-zinc-500"
    >
      New seed
    </button>
  </div>

  <pre
    data-output
    class:list={[
      'mt-4 max-h-96 overflow-auto whitespace-pre-wrap rounded-xl border border-zinc-200 bg-white p-4 text-sm leading-relaxed dark:border-zinc-800 dark:bg-zinc-900/60',
      accentColor,
    ]}
  >{initial}</pre>

  <div class="mt-6 flex flex-wrap justify-center gap-3">
    <button type="button" data-copy="[data-output]" class="rounded-full border border-zinc-300 px-4 py-2 text-sm font-medium transition hover:border-zinc-500 dark:border-zinc-700 dark:hover:border-zinc-500">
      Copy text
    </button>
    <button type="button" data-share class="rounded-full border border-zinc-300 px-4 py-2 text-sm font-medium transition hover:border-zinc-500 dark:border-zinc-700 dark:hover:border-zinc-500">
      Copy link
    </button>
  </div>
</div>

<script>
  import '../scripts/lorem';
</script>

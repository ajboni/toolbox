---
import { addDays, humanizeDays, toISODate } from '../lib/dates';
import { accentClasses, type AccentName, DEFAULT_ACCENT } from '../data/site';

interface Props {
  mode?: 'picker' | 'offset';
  days?: number;
  accent?: AccentName;
}

const { mode = 'picker', days = 30, accent = DEFAULT_ACCENT } = Astro.props;
const accentColor = accentClasses(accent).text;

const start = new Date();
const result = addDays(start, days);
const resultLong = result.toLocaleDateString('en-US', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const startLong = start.toLocaleDateString('en-US', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const { weeks, remainderDays, days: absDays } = humanizeDays(days);
const detail =
  days > 0
    ? `${days} days from ${startLong} — about ${weeks} weeks and ${remainderDays} days.`
    : days < 0
      ? `${absDays} days before ${startLong} — about ${weeks} weeks and ${remainderDays} days.`
      : `Same day as ${startLong}.`;
---

<div
  data-days-from
  data-mode={mode}
  data-days={days}
  class="rounded-2xl border border-zinc-200 bg-zinc-50 p-6 dark:border-zinc-800 dark:bg-zinc-900/50"
>
  {
    mode === 'picker' && (
      <div class="mx-auto grid max-w-md gap-4 sm:grid-cols-2">
        <label class="flex flex-col gap-1">
          <span class="text-sm font-medium text-zinc-600 dark:text-zinc-400">
            Start date
          </span>
          <input
            type="date"
            data-from-input
            value={toISODate(start)}
            class="rounded-lg border border-zinc-300 bg-white px-3 py-2 text-base text-zinc-900 focus:border-zinc-500 focus:outline-none dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100"
          />
        </label>
        <label class="flex flex-col gap-1">
          <span class="text-sm font-medium text-zinc-600 dark:text-zinc-400">
            Days
          </span>
          <input
            type="number"
            data-days-input
            value={days}
            step="1"
            class="rounded-lg border border-zinc-300 bg-white px-3 py-2 text-base text-zinc-900 focus:border-zinc-500 focus:outline-none dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100"
          />
        </label>
      </div>
    )
  }

  <div class="mt-8 text-center">
    <p
      data-result-date
      class:list={['text-3xl font-bold tracking-tight sm:text-4xl', accentColor]}
    >
      {resultLong}
    </p>
    <p
      data-result-detail
      class="mx-auto mt-4 max-w-md text-sm text-zinc-600 dark:text-zinc-400"
    >
      {detail}
    </p>
  </div>

  <div class="mt-8 flex justify-center">
    <button
      type="button"
      data-share
      class="rounded-full border border-zinc-300 px-4 py-2 text-sm font-medium transition hover:border-zinc-500 dark:border-zinc-700 dark:hover:border-zinc-500"
    >
      Copy link
    </button>
  </div>
</div>

<script>
  import '../scripts/days-from';
</script>

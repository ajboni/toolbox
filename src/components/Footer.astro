---
import { SITE } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-zinc-200 dark:border-zinc-800">
  <div
    class="mx-auto flex w-full max-w-4xl flex-col gap-1 px-4 py-6 text-sm text-zinc-500 dark:text-zinc-400"
  >
    <p>{SITE.name} · {SITE.tagline}</p>
    <p>
      &copy; {year} {SITE.name}. Built as a static site.
      <a
        href="/search/"
        class="ml-2 font-medium text-zinc-600 hover:text-zinc-900 dark:text-zinc-300 dark:hover:text-zinc-100"
      >
        Search
      </a>
      <a
        href="/changelog/"
        class="ml-2 font-medium text-zinc-600 hover:text-zinc-900 dark:text-zinc-300 dark:hover:text-zinc-100"
      >
        Changelog
      </a>
    </p>
  </div>
</footer>

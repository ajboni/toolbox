---
import { SITE } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-slate-200 dark:border-slate-800">
  <div
    class="mx-auto flex max-w-3xl flex-col gap-1 px-4 py-6 text-sm text-slate-500 dark:text-slate-400"
  >
    <p>{SITE.name} — {SITE.tagline}</p>
    <p>&copy; {year} {SITE.name}. Built as a static site.</p>
  </div>
</footer>

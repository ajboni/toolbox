---
import { accentClasses, type AccentName } from '../data/site';
import { COMMON_BASES, convertBase } from '../lib/base';

interface Props {
  accent?: AccentName;
}

const { accent = 'emerald' } = Astro.props;
const accentColor = accentClasses(accent).text;

const defaultBase = 10;
const defaultValue = '255';

const baseNames: Record<number, string> = {
  2: 'Binary',
  8: 'Octal',
  10: 'Decimal',
  16: 'Hexadecimal',
};

const outputs = COMMON_BASES.map((base) => ({
  base,
  name: baseNames[base],
  value: convertBase(defaultValue, defaultBase, base) ?? '–',
}));

const inputClass =
  'rounded-lg border border-zinc-300 bg-white px-3 py-2 text-base text-zinc-900 focus:border-zinc-500 focus:outline-none dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100';
const labelClass = 'flex flex-col gap-1';
const labelText = 'text-sm font-medium text-zinc-600 dark:text-zinc-400';
---

<div
  data-base-widget
  class="rounded-2xl border border-zinc-200 bg-zinc-50 p-6 dark:border-zinc-800 dark:bg-zinc-900/50"
>
  <div class="mx-auto grid max-w-lg gap-4 sm:grid-cols-2">
    <label class={labelClass}>
      <span class={labelText}>Value</span>
      <input
        type="text"
        inputmode="text"
        autocapitalize="off"
        autocomplete="off"
        spellcheck="false"
        data-value-input
        value={defaultValue}
        class={inputClass}
      />
    </label>
    <label class={labelClass}>
      <span class={labelText}>From base</span>
      <select data-from-select class={inputClass}>
        <option value="2">Binary (2)</option>
        <option value="8">Octal (8)</option>
        <option value="10" selected>Decimal (10)</option>
        <option value="16">Hexadecimal (16)</option>
        <option value="36">Base 36</option>
      </select>
    </label>
  </div>

  <dl class="mx-auto mt-8 grid max-w-lg gap-3 sm:grid-cols-2">
    {
      outputs.map((output) => (
        <div class="rounded-xl border border-zinc-200 bg-white p-4 dark:border-zinc-800 dark:bg-zinc-900/60">
          <dt class="text-xs font-medium uppercase tracking-wide text-zinc-500 dark:text-zinc-400">
            {output.name}
          </dt>
          <dd
            data-out={output.base}
            class:list={[
              'mt-1 break-all font-mono text-lg tabular-nums',
              output.base === defaultBase ? accentColor : 'text-zinc-900 dark:text-zinc-100',
            ]}
          >
            {output.value}
          </dd>
        </div>
      ))
    }
  </dl>

  <div class="mt-8 flex justify-center">
    <button
      type="button"
      data-share
      class="rounded-full border border-zinc-300 px-4 py-2 text-sm font-medium transition hover:border-zinc-500 dark:border-zinc-700 dark:hover:border-zinc-500"
    >
      Copy link
    </button>
  </div>
</div>

<script>
  import '../scripts/base-converter';
</script>

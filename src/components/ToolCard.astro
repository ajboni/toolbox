---
interface Props {
  title: string;
  description: string;
  href: string;
}

const { title, description, href } = Astro.props;
---

<a
  href={href}
  class="block rounded-xl border border-slate-200 p-5 transition hover:border-slate-400 hover:shadow-sm dark:border-slate-800 dark:hover:border-slate-600"
>
  <h3 class="text-base font-semibold">{title}</h3>
  <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{description}</p>
</a>

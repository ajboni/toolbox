---
import { accentClasses, type AccentName, DEFAULT_ACCENT } from '../data/site';

interface Props {
  title: string;
  description: string;
  href: string;
  accent?: AccentName;
  isNew?: boolean;
}

const { title, description, href, accent = DEFAULT_ACCENT, isNew = false } = Astro.props;
const colors = accentClasses(accent);
---

<a
  href={href}
  class:list={[
    'block rounded-xl border border-zinc-200 p-5 transition hover:shadow-sm dark:border-zinc-800',
    colors.borderHover,
  ]}
>
  <h3 class="flex items-center gap-2 text-base font-semibold">
    <span class:list={['h-2 w-2 rounded-full', colors.bg]} aria-hidden="true"
    ></span>
    {title}
    {
      isNew && (
        <span class="rounded-full bg-emerald-50 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-300">
          New
        </span>
      )
    }
  </h3>
  <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">{description}</p>
</a>

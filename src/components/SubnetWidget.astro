---
import { accentClasses, type AccentName } from '../data/site';
import { subnetInfo } from '../lib/subnet';

interface Props {
  accent?: AccentName;
}

const { accent = 'teal' } = Astro.props;
const accentColor = accentClasses(accent).text;

const DEFAULT_CIDR = '192.168.1.0/24';
const initial = subnetInfo(DEFAULT_CIDR);

const fields = initial.ok
  ? [
      { key: 'broadcast', label: 'Broadcast', value: initial.info.broadcast },
      { key: 'firstHost', label: 'First host', value: initial.info.firstHost ?? '–' },
      { key: 'lastHost', label: 'Last host', value: initial.info.lastHost ?? '–' },
      { key: 'netmask', label: 'Netmask', value: initial.info.netmask },
      { key: 'wildcard', label: 'Wildcard', value: initial.info.wildcard },
      {
        key: 'totalAddresses',
        label: 'Total addresses',
        value: initial.info.totalAddresses.toLocaleString('en-US'),
      },
      {
        key: 'usableHosts',
        label: 'Usable hosts',
        value: initial.info.usableHosts.toLocaleString('en-US'),
      },
    ]
  : [];
const initialHeadline = initial.ok ? `${initial.info.network}/${initial.info.prefix}` : '–';

const inputClass =
  'w-full rounded-lg border border-zinc-300 bg-white px-3 py-2 text-base text-zinc-900 focus:border-zinc-500 focus:outline-none dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100';
---

<div
  data-subnet-widget
  class="rounded-2xl border border-zinc-200 bg-zinc-50 p-6 dark:border-zinc-800 dark:bg-zinc-900/50"
>
  <label class="mx-auto flex max-w-lg flex-col gap-1">
    <span class="text-sm font-medium text-zinc-600 dark:text-zinc-400">
      IPv4 address or CIDR block
    </span>
    <input
      type="text"
      inputmode="text"
      autocapitalize="off"
      autocomplete="off"
      spellcheck="false"
      data-cidr
      value={DEFAULT_CIDR}
      placeholder="192.168.1.0/24"
      class={inputClass}
    />
  </label>

  <p
    data-error
    class="mx-auto mt-2 hidden max-w-lg text-sm text-rose-600 dark:text-rose-400"
  >
  </p>

  <div class="mt-8 text-center">
    <p
      data-result-value
      class:list={['text-4xl font-bold tabular-nums tracking-tight sm:text-5xl', accentColor]}
    >
      {initialHeadline}
    </p>
    <p data-note class="mx-auto mt-3 max-w-md text-sm text-zinc-600 dark:text-zinc-400">
      {initial.ok
        ? `${initial.info.usableHosts.toLocaleString('en-US')} usable hosts in this block.`
        : ''}
    </p>
  </div>

  <dl class="mx-auto mt-8 grid max-w-lg gap-3 sm:grid-cols-2">
    {
      fields.map((field) => (
        <div class="rounded-xl border border-zinc-200 bg-white p-4 dark:border-zinc-800 dark:bg-zinc-900/60">
          <dt class="text-xs font-medium uppercase tracking-wide text-zinc-500 dark:text-zinc-400">
            {field.label}
          </dt>
          <dd
            data-out={field.key}
            class="mt-1 break-all font-mono text-lg tabular-nums text-zinc-900 dark:text-zinc-100"
          >
            {field.value}
          </dd>
        </div>
      ))
    }
  </dl>

  <div class="mt-8 flex justify-center">
    <button
      type="button"
      data-share
      class="rounded-full border border-zinc-300 px-4 py-2 text-sm font-medium transition hover:border-zinc-500 dark:border-zinc-700 dark:hover:border-zinc-500"
    >
      Copy link
    </button>
  </div>
</div>

<script>
  import '../scripts/subnet';
</script>

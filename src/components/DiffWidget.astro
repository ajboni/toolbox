---
import { accentClasses, type AccentName } from '../data/site';
import { beautifyForDiff } from '../lib/codeFormat';
import { diffLines, diffSummary, splitDiffLines } from '../lib/diff';
import {
  DIFF_ROW_TINT,
  DIFF_SPLIT_CELL,
  DIFF_SPLIT_EMPTY,
  DIFF_SPLIT_GUTTER,
  DIFF_SPLIT_LEFT,
  DIFF_SPLIT_ROW,
  DIFF_SPLIT_TEXT,
  VIEW_BUTTON_ACTIVE,
  VIEW_BUTTON_BASE,
  VIEW_BUTTON_INACTIVE,
  describeDetectedFormat,
  describeDiff,
} from '../lib/diffView';

interface Props {
  accent?: AccentName;
}

const { accent = 'sky' } = Astro.props;
const accentColor = accentClasses(accent).text;

const defaultA = '{"name":"bajtools","category":"text","tools":["json","diff"],"open":true}';
const defaultB = '{"name":"bajtools","category":"text","tools":["json","diff"],"open":false}';

const formattedA = beautifyForDiff(defaultA);
const formattedB = beautifyForDiff(defaultB);
const initialLines = diffLines(formattedA.text, formattedB.text, {
  ignoreTrailingWhitespace: true,
});
const initialSummary = describeDiff(diffSummary(initialLines));
const initialSplit = splitDiffLines(initialLines);
const initialHintA = describeDetectedFormat(formattedA.format, true);
const initialHintB = describeDetectedFormat(formattedB.format, true);

const textareaClass =
  'w-full rounded-lg border border-zinc-300 bg-white px-3 py-2 font-mono text-xs text-zinc-900 focus:border-zinc-500 focus:outline-none dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100';
const labelText = 'text-sm font-medium text-zinc-600 dark:text-zinc-400';
const hintClass = 'text-xs text-zinc-500 dark:text-zinc-500';
const checkboxClass =
  'h-3.5 w-3.5 rounded border-zinc-300 accent-sky-600 dark:border-zinc-600';
const optionText = 'flex items-center gap-2 text-xs font-medium text-zinc-600 dark:text-zinc-400';
const selectClass =
  'rounded-lg border border-zinc-300 bg-white px-2 py-1 text-xs text-zinc-900 focus:border-zinc-500 focus:outline-none dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100';
const buttonClass =
  'rounded-full border border-zinc-300 px-4 py-2 text-sm font-medium transition hover:border-zinc-500 disabled:cursor-not-allowed disabled:opacity-40 dark:border-zinc-700 dark:hover:border-zinc-500';
const splitButtonClass = `${VIEW_BUTTON_BASE} ${VIEW_BUTTON_ACTIVE}`;
const unifiedButtonClass = `${VIEW_BUTTON_BASE} ${VIEW_BUTTON_INACTIVE}`;
---

<div
  data-diff-widget
  class="rounded-2xl border border-zinc-200 bg-zinc-50 p-4 dark:border-zinc-800 dark:bg-zinc-900/50 sm:p-6"
>
  <div class="grid gap-x-4 gap-y-1 sm:grid-cols-2">
    <textarea
      id="diff-a"
      data-diff-a
      rows="8"
      spellcheck="false"
      class:list={[textareaClass, 'max-sm:order-2 sm:col-start-1 sm:row-start-2']}>{defaultA}</textarea
    >

    <textarea
      id="diff-b"
      data-diff-b
      rows="8"
      spellcheck="false"
      class:list={[textareaClass, 'max-sm:order-5 sm:col-start-2 sm:row-start-2']}>{defaultB}</textarea
    >

    <div
      class="flex items-center justify-between gap-2 max-sm:order-1 sm:col-start-1 sm:row-start-1"
    >
      <label for="diff-a" class={labelText}>Original</label>
      <label for="diff-format-a" class={optionText}>
        <input
          id="diff-format-a"
          type="checkbox"
          data-format-a
          checked
          class={checkboxClass}
        />
        <span>Format</span>
      </label>
    </div>

    <div
      class="flex items-center justify-between gap-2 max-sm:order-4 max-sm:mt-3 sm:col-start-2 sm:row-start-1"
    >
      <label for="diff-b" class={labelText}>Changed</label>
      <label for="diff-format-b" class={optionText}>
        <input
          id="diff-format-b"
          type="checkbox"
          data-format-b
          checked
          class={checkboxClass}
        />
        <span>Format</span>
      </label>
    </div>

    <p
      data-hint-a
      class:list={[hintClass, 'max-sm:order-3 sm:col-start-1 sm:row-start-3']}
      aria-live="polite">{initialHintA}</p
    >
    <p
      data-hint-b
      class:list={[hintClass, 'max-sm:order-6 sm:col-start-2 sm:row-start-3']}
      aria-live="polite">{initialHintB}</p
    >
  </div>

  <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
    <p data-diff-summary class:list={['text-sm font-medium', accentColor]} aria-live="polite">
      {initialSummary}
    </p>
    <div class="flex flex-wrap items-center gap-2">
      <label for="diff-indent" class={optionText}>
        <span>Indent</span>
        <select id="diff-indent" data-indent class={selectClass}>
          <option value="2" selected>2 spaces</option>
          <option value="4">4 spaces</option>
          <option value="tab">Tabs</option>
        </select>
      </label>
      <label for="diff-whitespace" class={optionText}>
        <input
          id="diff-whitespace"
          type="checkbox"
          data-ignore-whitespace
          checked
          class={checkboxClass}
        />
        <span>Ignore trailing spaces</span>
      </label>
      <div
        role="group"
        aria-label="Diff view"
        class="inline-flex items-center rounded-full border border-zinc-300 p-0.5 dark:border-zinc-700"
      >
        <button
          type="button"
          data-view-split
          aria-pressed="true"
          class={splitButtonClass}>Side by side</button
        >
        <button
          type="button"
          data-view-unified
          aria-pressed="false"
          class={unifiedButtonClass}>Unified</button
        >
      </div>
      <button type="button" data-swap class={buttonClass}>Swap sides</button>
    </div>
  </div>

  <div
    data-diff-split
    class="mt-2 overflow-auto rounded-lg border border-zinc-200 bg-white dark:border-zinc-800 dark:bg-zinc-900"
  >
    {
      initialSplit.map((row) => (
        <div class={DIFF_SPLIT_ROW}>
          {row.left ? (
            <div class:list={[DIFF_SPLIT_CELL, DIFF_SPLIT_LEFT, DIFF_ROW_TINT[row.left.type]]}>
              <span class={DIFF_SPLIT_GUTTER}>{row.left.line}</span>
              <span class={DIFF_SPLIT_TEXT}>{row.left.text}</span>
            </div>
          ) : (
            <div class:list={[DIFF_SPLIT_CELL, DIFF_SPLIT_LEFT, DIFF_SPLIT_EMPTY]} />
          )}
          {row.right ? (
            <div class:list={[DIFF_SPLIT_CELL, DIFF_ROW_TINT[row.right.type]]}>
              <span class={DIFF_SPLIT_GUTTER}>{row.right.line}</span>
              <span class={DIFF_SPLIT_TEXT}>{row.right.text}</span>
            </div>
          ) : (
            <div class:list={[DIFF_SPLIT_CELL, DIFF_SPLIT_EMPTY]} />
          )}
        </div>
      ))
    }
  </div>

  <div
    data-diff-unified
    hidden
    class="mt-2 overflow-auto rounded-lg border border-zinc-200 bg-white dark:border-zinc-800 dark:bg-zinc-900"
  >
  </div>

  <div class="mt-6 flex flex-wrap justify-center gap-3">
    <button type="button" data-copy-diff disabled class={buttonClass}>Copy diff</button>
  </div>
</div>

<script>
  import '../scripts/diff';
</script>

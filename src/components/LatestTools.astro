---
import { accentClasses, findCategory } from '../data/site';
import { TOOLS } from '../data/tools';
import { formatAdded, latestTools } from '../lib/toolFreshness';

const latest = latestTools(TOOLS);
---

<section class="mt-10">
  <div class="flex items-baseline justify-between gap-4">
    <h2 class="text-lg font-semibold tracking-tight">Latest additions</h2>
    <a
      href="/changelog/"
      class="text-sm text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100"
    >
      What's new
    </a>
  </div>
  <ul class="mt-3 divide-y divide-zinc-200 dark:divide-zinc-800">
    {
      latest.map((tool) => {
        const category = findCategory(tool.category);
        const accent = accentClasses(category?.accent);
        return (
          <li>
            <a
              href={tool.path}
              class="-mx-2 flex items-center gap-3 rounded-lg px-2 py-2.5 transition hover:bg-zinc-50 dark:hover:bg-zinc-900"
            >
              <span class:list={['h-2 w-2 shrink-0 rounded-full', accent.bg]} aria-hidden="true" />
              <span class="min-w-0 flex-1 truncate text-sm font-medium">{tool.title}</span>
              <span class="hidden shrink-0 text-xs text-zinc-500 sm:inline dark:text-zinc-400">
                {category?.name}
              </span>
              <time
                datetime={tool.added}
                class="w-12 shrink-0 text-right text-xs text-zinc-400 dark:text-zinc-500"
              >
                {formatAdded(tool.added)}
              </time>
            </a>
          </li>
        );
      })
    }
  </ul>
</section>

---
import { accentClasses, type AccentName } from '../data/site';
import { convertCase, type CaseMode } from '../lib/caseConvert';

interface Props {
  accent?: AccentName;
}

const { accent = 'sky' } = Astro.props;
const accentColor = accentClasses(accent).text;

const defaultValue = 'hello world again';
const cases: { mode: CaseMode; label: string }[] = [
  { mode: 'camel', label: 'camelCase' },
  { mode: 'pascal', label: 'PascalCase' },
  { mode: 'snake', label: 'snake_case' },
  { mode: 'kebab', label: 'kebab-case' },
  { mode: 'constant', label: 'CONSTANT_CASE' },
  { mode: 'title', label: 'Title Case' },
  { mode: 'sentence', label: 'Sentence case' },
  { mode: 'lower', label: 'lower case' },
  { mode: 'upper', label: 'UPPER CASE' },
];

const textareaClass =
  'w-full rounded-lg border border-zinc-300 bg-white px-3 py-2 font-mono text-sm text-zinc-900 focus:border-zinc-500 focus:outline-none dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100';
const copyClass =
  'rounded-full border border-zinc-300 px-3 py-1 text-xs font-medium text-zinc-600 transition hover:border-zinc-500 dark:border-zinc-700 dark:text-zinc-400 dark:hover:border-zinc-500';
---

<div
  data-case-widget
  class="rounded-2xl border border-zinc-200 bg-zinc-50 p-6 dark:border-zinc-800 dark:bg-zinc-900/50"
>
  <label class="flex flex-col gap-1">
    <span class="text-sm font-medium text-zinc-600 dark:text-zinc-400">Your text</span>
    <textarea data-text-input rows="2" class={textareaClass}>{defaultValue}</textarea>
  </label>

  <div class="mt-6 grid gap-3 sm:grid-cols-2">
    {
      cases.map((item) => (
        <div class="rounded-xl border border-zinc-200 bg-white p-3 dark:border-zinc-800 dark:bg-zinc-900/60">
          <div class="flex items-center justify-between gap-2">
            <span class="text-xs font-medium uppercase tracking-wide text-zinc-500 dark:text-zinc-400">
              {item.label}
            </span>
            <button type="button" data-copy={`[data-case="${item.mode}"]`} class={copyClass}>
              Copy
            </button>
          </div>
          <code
            data-case={item.mode}
            class:list={['mt-1 block break-all text-sm', accentColor]}
          >
            {convertCase(defaultValue, item.mode)}
          </code>
        </div>
      ))
    }
  </div>

  <div class="mt-6 flex justify-center">
    <button
      type="button"
      data-share
      class="rounded-full border border-zinc-300 px-4 py-2 text-sm font-medium transition hover:border-zinc-500 dark:border-zinc-700 dark:hover:border-zinc-500"
    >
      Copy link
    </button>
  </div>
</div>

<script>
  import '../scripts/case-converter';
</script>

---
import { accentClasses, type AccentName } from '../data/site';
import { generatePassword, passwordEntropyBits } from '../lib/password';

interface Props {
  accent?: AccentName;
}

const { accent = 'rose' } = Astro.props;
const accentColor = accentClasses(accent).text;

const defaultOptions = {
  length: 20,
  lower: true,
  upper: true,
  digits: true,
  symbols: true,
  excludeAmbiguous: false,
};
const initial = generatePassword(defaultOptions);
const initialBits = Math.round(passwordEntropyBits(defaultOptions));

const inputClass =
  'rounded-lg border border-zinc-300 bg-white px-3 py-2 text-sm text-zinc-900 focus:border-zinc-500 focus:outline-none dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100';
const checkboxClass = 'h-4 w-4';
const labelClass =
  'flex items-center gap-2 text-sm font-medium text-zinc-600 dark:text-zinc-400';
---

<div
  data-password-widget
  class="rounded-2xl border border-zinc-200 bg-zinc-50 p-6 dark:border-zinc-800 dark:bg-zinc-900/50"
>
  <div class="inline-flex rounded-full border border-zinc-300 p-1 dark:border-zinc-700" role="tablist">
    <button
      type="button"
      role="tab"
      data-mode-btn="pass"
      aria-selected="true"
      class="rounded-full px-4 py-1.5 text-sm font-medium transition"
    >
      Password
    </button>
    <button
      type="button"
      role="tab"
      data-mode-btn="phrase"
      aria-selected="false"
      class="rounded-full px-4 py-1.5 text-sm font-medium transition"
    >
      Passphrase
    </button>
  </div>

  <div data-panel="pass" class="mt-5 space-y-4">
    <label class="flex flex-col gap-1 text-sm font-medium text-zinc-600 dark:text-zinc-400">
      <span>Length</span>
      <input
        type="number"
        min="4"
        max="128"
        step="1"
        data-length-input
        value={defaultOptions.length}
        class:list={[inputClass, 'w-28']}
      />
    </label>
    <div class="flex flex-wrap gap-x-6 gap-y-2">
      <label class={labelClass}>
        <input type="checkbox" data-lower-input checked={defaultOptions.lower} class={checkboxClass} />
        <span>a-z</span>
      </label>
      <label class={labelClass}>
        <input type="checkbox" data-upper-input checked={defaultOptions.upper} class={checkboxClass} />
        <span>A-Z</span>
      </label>
      <label class={labelClass}>
        <input type="checkbox" data-digits-input checked={defaultOptions.digits} class={checkboxClass} />
        <span>0-9</span>
      </label>
      <label class={labelClass}>
        <input type="checkbox" data-symbols-input checked={defaultOptions.symbols} class={checkboxClass} />
        <span>Symbols</span>
      </label>
    </div>
    <label class={labelClass}>
      <input type="checkbox" data-ambiguous-input class={checkboxClass} />
      <span>Exclude ambiguous characters (il1IoO0)</span>
    </label>
  </div>

  <div data-panel="phrase" class="mt-5 hidden space-y-4">
    <div class="flex flex-wrap gap-4">
      <label class="flex flex-col gap-1 text-sm font-medium text-zinc-600 dark:text-zinc-400">
        <span>Words</span>
        <input
          type="number"
          min="3"
          max="12"
          step="1"
          data-words-input
          value="8"
          class:list={[inputClass, 'w-24']}
        />
      </label>
      <label class="flex flex-col gap-1 text-sm font-medium text-zinc-600 dark:text-zinc-400">
        <span>Separator</span>
        <input
          type="text"
          maxlength="3"
          data-separator-input
          value="-"
          class:list={[inputClass, 'w-24']}
        />
      </label>
    </div>
    <div class="flex flex-wrap gap-x-6 gap-y-2">
      <label class={labelClass}>
        <input type="checkbox" data-capitalize-input checked class={checkboxClass} />
        <span>Capitalize words</span>
      </label>
      <label class={labelClass}>
        <input type="checkbox" data-append-number-input class={checkboxClass} />
        <span>Append a digit to a random word</span>
      </label>
    </div>
  </div>

  <div class="mt-5 flex flex-wrap items-end gap-4">
    <label class="flex flex-col gap-1 text-sm font-medium text-zinc-600 dark:text-zinc-400">
      <span>How many</span>
      <input
        type="number"
        min="1"
        max="100"
        step="1"
        data-count-input
        value="1"
        class:list={[inputClass, 'w-24']}
      />
    </label>
    <button
      type="button"
      data-generate
      class="mb-0.5 rounded-full bg-zinc-900 px-4 py-2 text-sm font-medium text-white transition hover:bg-zinc-700 dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-zinc-300"
    >
      Generate
    </button>
  </div>

  <pre
    data-output
    class:list={[
      'mt-4 max-h-80 overflow-auto whitespace-pre-wrap break-all rounded-xl border border-zinc-200 bg-white p-4 font-mono text-sm leading-relaxed dark:border-zinc-800 dark:bg-zinc-900/60',
      accentColor,
    ]}>{initial}</pre>

  <div class="mt-4 flex flex-wrap items-center gap-3">
    <div class="h-2 w-40 overflow-hidden rounded-full bg-zinc-200 dark:bg-zinc-800">
      <div data-strength-bar class="h-full w-0 rounded-full transition-all" style="background-color:#ef4444"></div>
    </div>
    <span class="text-sm font-medium text-zinc-600 dark:text-zinc-400">
      <span data-strength-label>Weak</span>
      <span aria-hidden="true">·</span>
      <span data-strength-bits>{initialBits}</span> bits
    </span>
  </div>

  <div class="mt-6 flex flex-wrap justify-center gap-3">
    <button type="button" data-copy="[data-output]" class="rounded-full border border-zinc-300 px-4 py-2 text-sm font-medium transition hover:border-zinc-500 dark:border-zinc-700 dark:hover:border-zinc-500">
      Copy
    </button>
    <button type="button" data-share class="rounded-full border border-zinc-300 px-4 py-2 text-sm font-medium transition hover:border-zinc-500 dark:border-zinc-700 dark:hover:border-zinc-500">
      Copy link
    </button>
  </div>
</div>

<script>
  import '../scripts/password';
</script>

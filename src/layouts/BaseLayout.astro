---
import SeoHead from '../components/SeoHead.astro';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import SearchPalette from '../components/SearchPalette.astro';
import { SITE } from '../data/site';
import { TOOLS } from '../data/tools';
import { ANALYTICS } from '../data/analytics';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  wide?: boolean;
}

const { title, description, canonicalPath, jsonLd, noindex, wide = false } = Astro.props;
const toolPath = TOOLS.some((tool) => tool.path === canonicalPath) ? canonicalPath : undefined;
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <SeoHead
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      jsonLd={jsonLd}
      noindex={noindex}
    />
    {
      ANALYTICS.cfToken && (
        <script
          is:inline
          type="module"
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: ANALYTICS.cfToken })}
        />
      )
    }
  </head>
  <body
    class="min-h-screen bg-white text-zinc-900 dark:bg-zinc-950 dark:text-zinc-100"
    data-tool-path={toolPath}
  >
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-zinc-900 focus:px-4 focus:py-2 focus:text-sm focus:text-white dark:focus:bg-zinc-100 dark:focus:text-zinc-900"
    >
      Skip to content
    </a>

    <div class="lg:flex">
      <Header />
      <div
        data-sidebar-overlay
        hidden
        class="fixed inset-0 z-30 bg-zinc-950/50 lg:hidden"
      >
      </div>
      <Sidebar />
      <div class="flex min-w-0 flex-1 flex-col">
        <main
          id="main"
          class:list={[
            'mx-auto w-full flex-1 px-4 pb-10 pt-6 sm:px-8 sm:py-10',
            wide ? 'max-w-6xl' : 'max-w-4xl',
          ]}
        >
          <slot />
        </main>
        <Footer wide={wide} />
      </div>
    </div>

    <SearchPalette />

    <script>
      import '../scripts/sidebar';
      import '../scripts/searchPalette';
      import '../scripts/toolVisit';
    </script>
  </body>
</html>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CircleOfFifths from '../../components/CircleOfFifths.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import { breadcrumbs, webApplication } from '../../lib/jsonld';

const canonicalPath = '/music/circle-of-fifths/';

const jsonLd = [
  webApplication({
    name: 'Circle of Fifths',
    description:
      'Interactive circle of fifths chord wheel: browse all twelve major keys across four rings (diminished, minor, major and key signature) and highlight each key’s diatonic chords.',
    path: canonicalPath,
  }),
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Music', path: '/music/' },
    { name: 'Circle of Fifths', path: canonicalPath },
  ]),
];
---

<BaseLayout
  title="Circle of Fifths · Interactive Chord Wheel"
  description="An interactive circle of fifths chord wheel. Rotate to any key to highlight its I–IV–V, ii–iii–vi and vii° chords, and see the key signature and diatonic chords. Free, fast and shareable."
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
>
  <nav class="text-sm text-zinc-500 dark:text-zinc-400" aria-label="Breadcrumb">
    <a href="/" class="hover:text-zinc-900 dark:hover:text-zinc-100">Home</a>
    <span class="mx-2">/</span>
    <a href="/music/" class="hover:text-zinc-900 dark:hover:text-zinc-100">Music</a>
    <span class="mx-2">/</span>
    <span>Circle of Fifths</span>
  </nav>

  <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
    Circle of Fifths
  </h1>
  <p class="mt-3 max-w-xl text-zinc-600 dark:text-zinc-400">
    Each step clockwise moves up a perfect fifth. The wheel has four rings:
    diminished (vii°), minor (ii/iii/vi), major (I/IV/V) and key signature,
    and the pointer marks the selected key. Click any cell to hear its chord;
    the family of the selected key lights up around the wheel, and the
    selection is saved in the URL so you can share it.
  </p>

  <div class="mt-8">
    <CircleOfFifths />
  </div>

  <section class="mt-12 space-y-3 text-zinc-700 dark:text-zinc-300">
    <h2 class="text-xl font-semibold tracking-tight">How it works</h2>
    <p class="text-sm leading-relaxed">
      Moving a fifth up adds one sharp (or removes one flat); moving a fifth down
      does the opposite. That is why neighbouring keys always differ by a single
      accidental, which makes them the easiest keys to modulate between. It is
      also why the three chords of a key that are not its tonic (IV and V in the
      major ring, and ii, iii and vi in the minor ring) always sit in the two
      sectors next to it.
    </p>
  </section>

  <RelatedTools category="music" current={canonicalPath} />
</BaseLayout>

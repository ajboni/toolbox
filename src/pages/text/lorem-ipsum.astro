---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LoremWidget from '../../components/LoremWidget.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import { breadcrumbs, webApplication } from '../../lib/jsonld';

const canonicalPath = '/text/lorem-ipsum/';

const jsonLd = [
  webApplication({
    name: 'Lorem Ipsum Generator',
    description: 'Generate placeholder paragraphs, sentences or words with a reproducible seed.',
    path: canonicalPath,
  }),
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Text & Code', path: '/text/' },
    { name: 'Lorem Ipsum', path: canonicalPath },
  ]),
];
---

<BaseLayout
  title="Lorem Ipsum Generator · Placeholder Text"
  description="Generate lorem ipsum placeholder text by paragraphs, sentences or words. Deterministic seeds make any result reproducible and shareable."
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
>
  <nav class="text-sm text-zinc-500 dark:text-zinc-400" aria-label="Breadcrumb">
    <a href="/" class="hover:text-zinc-900 dark:hover:text-zinc-100">Home</a>
    <span class="mx-2">/</span>
    <a href="/text/" class="hover:text-zinc-900 dark:hover:text-zinc-100">Text &amp; Code</a>
    <span class="mx-2">/</span>
    <span>Lorem Ipsum</span>
  </nav>

  <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
    Lorem ipsum generator
  </h1>
  <p class="mt-3 max-w-xl text-zinc-600 dark:text-zinc-400">
    Produce placeholder text for layouts and mock-ups: choose paragraphs,
    sentences or words. Because the output is driven by a seed, the same settings
    always give the same text, perfect for sharing or reruns.
  </p>

  <div class="mt-8">
    <LoremWidget accent="sky" />
  </div>

  <section class="mt-12 space-y-3 text-zinc-700 dark:text-zinc-300">
    <h2 class="text-xl font-semibold tracking-tight">How it works</h2>
    <p class="text-sm leading-relaxed">
      A small seeded pseudo-random generator picks words from a Latin word bank,
      so the result is identical every time you use the same seed. Change the seed
      for a fresh variation, or leave it as is and share the link.
    </p>
  </section>

  <RelatedTools category="text" current={canonicalPath} />
</BaseLayout>

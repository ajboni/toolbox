---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonWidget from '../../components/JsonWidget.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import { breadcrumbs, webApplication } from '../../lib/jsonld';

const canonicalPath = '/text/json/';

const jsonLd = [
  webApplication({
    name: 'JSON Formatter',
    description: 'Pretty-print or minify JSON with clear, line-aware error messages.',
    path: canonicalPath,
  }),
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Text & Code', path: '/text/' },
    { name: 'JSON', path: canonicalPath },
  ]),
];
---

<BaseLayout
  title="JSON Formatter and Minifier"
  description="Pretty-print or minify JSON in your browser. Spot syntax errors with line and column numbers, and share the exact input via the URL."
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
>
  <nav class="text-sm text-zinc-500 dark:text-zinc-400" aria-label="Breadcrumb">
    <a href="/" class="hover:text-zinc-900 dark:hover:text-zinc-100">Home</a>
    <span class="mx-2">/</span>
    <a href="/text/" class="hover:text-zinc-900 dark:hover:text-zinc-100">Text &amp; Code</a>
    <span class="mx-2">/</span>
    <span>JSON</span>
  </nav>

  <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">JSON formatter</h1>
  <p class="mt-3 max-w-xl text-zinc-600 dark:text-zinc-400">
    Paste JSON to pretty-print it with your chosen indentation or squeeze it onto
    a single line. Invalid input reports the line and column of the problem. The
    text never leaves your browser, and the input rides along in the URL so you
    can share it.
  </p>

  <div class="mt-8">
    <JsonWidget accent="sky" />
  </div>

  <section class="mt-12 space-y-3 text-zinc-700 dark:text-zinc-300">
    <h2 class="text-xl font-semibold tracking-tight">How it works</h2>
    <p class="text-sm leading-relaxed">
      Parsing uses the browser's native <code>JSON.parse</code>, so the tool
      accepts exactly the same input as your code does. Pretty mode re-serialises
      it with the indentation you pick; minify mode drops every optional space.
      Nothing is uploaded: the parsing and formatting happen locally.
    </p>
  </section>

  <RelatedTools category="text" current={canonicalPath} />
</BaseLayout>

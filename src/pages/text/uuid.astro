---
import BaseLayout from '../../layouts/BaseLayout.astro';
import UuidWidget from '../../components/UuidWidget.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import { breadcrumbs, webApplication } from '../../lib/jsonld';

const canonicalPath = '/text/uuid/';

const jsonLd = [
  webApplication({
    name: 'UUID Generator',
    description: 'Generate random version 4 UUIDs, one or many, with optional uppercase.',
    path: canonicalPath,
  }),
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Text & Code', path: '/text/' },
    { name: 'UUID Generator', path: canonicalPath },
  ]),
];
---

<BaseLayout
  title="UUID Generator · Version 4 (Random)"
  description="Generate one or many random version 4 UUIDs in your browser. No sign-up, nothing is sent anywhere, and the settings are shareable via URL."
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
>
  <nav class="text-sm text-zinc-500 dark:text-zinc-400" aria-label="Breadcrumb">
    <a href="/" class="hover:text-zinc-900 dark:hover:text-zinc-100">Home</a>
    <span class="mx-2">/</span>
    <a href="/text/" class="hover:text-zinc-900 dark:hover:text-zinc-100">Text &amp; Code</a>
    <span class="mx-2">/</span>
    <span>UUID Generator</span>
  </nav>

  <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">UUID generator</h1>
  <p class="mt-3 max-w-xl text-zinc-600 dark:text-zinc-400">
    Create random version 4 UUIDs: pick how many and whether to upper-case them.
    Generation happens entirely in your browser using <code>crypto</code>, so the
    values are cryptographically random and never leave your device.
  </p>

  <div class="mt-8">
    <UuidWidget accent="sky" />
  </div>

  <section class="mt-12 space-y-3 text-zinc-700 dark:text-zinc-300">
    <h2 class="text-xl font-semibold tracking-tight">How it works</h2>
    <p class="text-sm leading-relaxed">
      A version 4 UUID is 128 random bits arranged as 32 hexadecimal digits in
      five groups. The version and variant bits are fixed, leaving 122 random
      bits, which makes collisions practically impossible.
    </p>
  </section>

  <RelatedTools category="text" current={canonicalPath} />
</BaseLayout>

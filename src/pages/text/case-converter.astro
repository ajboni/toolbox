---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseConverterWidget from '../../components/CaseConverterWidget.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import { breadcrumbs, webApplication } from '../../lib/jsonld';

const canonicalPath = '/text/case-converter/';

const jsonLd = [
  webApplication({
    name: 'Case Converter',
    description: 'Convert text between camelCase, snake_case, kebab-case and more.',
    path: canonicalPath,
  }),
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Text & Code', path: '/text/' },
    { name: 'Case Converter', path: canonicalPath },
  ]),
];
---

<BaseLayout
  title="Case Converter · camelCase, snake_case, kebab-case"
  description="Turn any text into camelCase, PascalCase, snake_case, kebab-case, CONSTANT_CASE and more, all at once. Free and shareable via URL."
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
>
  <nav class="text-sm text-zinc-500 dark:text-zinc-400" aria-label="Breadcrumb">
    <a href="/" class="hover:text-zinc-900 dark:hover:text-zinc-100">Home</a>
    <span class="mx-2">/</span>
    <a href="/text/" class="hover:text-zinc-900 dark:hover:text-zinc-100">Text &amp; Code</a>
    <span class="mx-2">/</span>
    <span>Case Converter</span>
  </nav>

  <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
    Case converter
  </h1>
  <p class="mt-3 max-w-xl text-zinc-600 dark:text-zinc-400">
    Type or paste your text and get every common naming style at once. It is handy
    for turning a sentence into a variable name, a slug or a constant. Your input
    is kept in the URL so the exact result can be shared.
  </p>

  <div class="mt-8">
    <CaseConverterWidget accent="sky" />
  </div>

  <section class="mt-12 space-y-3 text-zinc-700 dark:text-zinc-300">
    <h2 class="text-xl font-semibold tracking-tight">How it works</h2>
    <p class="text-sm leading-relaxed">
      The text is split into words on spaces, punctuation and camel-case
      boundaries (so <code>helloWorld</code> becomes two words). Each style then
      re-joins those words with its own casing and separator.
    </p>
  </section>

  <RelatedTools category="text" current={canonicalPath} />
</BaseLayout>

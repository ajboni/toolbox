---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DiffWidget from '../../components/DiffWidget.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import { breadcrumbs, webApplication } from '../../lib/jsonld';

const canonicalPath = '/text/diff/';

const jsonLd = [
  webApplication({
    name: 'Diff Checker',
    description:
      'Compare two blocks of text side by side, with automatic JSON and XML formatting.',
    path: canonicalPath,
  }),
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Text & Code', path: '/text/' },
    { name: 'Diff', path: canonicalPath },
  ]),
];
---

<BaseLayout
  title="Diff Checker"
  description="Compare two blocks of text side by side, with minified JSON and XML pretty-printed before the diff. Additions, removals and a summary, all in your browser."
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
  wide
  focusFill
>
  <nav class="text-sm text-zinc-500 dark:text-zinc-400" aria-label="Breadcrumb">
    <a href="/" class="hover:text-zinc-900 dark:hover:text-zinc-100">Home</a>
    <span class="mx-2">/</span>
    <a href="/text/" class="hover:text-zinc-900 dark:hover:text-zinc-100">Text &amp; Code</a>
    <span class="mx-2">/</span>
    <span>Diff</span>
  </nav>

  <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">Diff checker</h1>
  <p class="mt-3 max-w-xl text-zinc-600 dark:text-zinc-400">
    Paste the original text on the left and the changed text on the right to see
    a line-by-line comparison side by side. Minified JSON and XML are detected
    and pretty-printed before the diff, and each side has its own format toggle.
    Added lines are green, removed lines are red, and a summary tells you how
    much changed. Everything runs locally: your text stays in this tab and is
    never uploaded or added to the link.
  </p>

  <div class="mt-8">
    <DiffWidget accent="sky" />
  </div>

  <section class="mt-12 max-w-3xl space-y-3 text-zinc-700 dark:text-zinc-300">
    <h2 class="text-xl font-semibold tracking-tight">How it works</h2>
    <p class="text-sm leading-relaxed">
      The tool splits both blocks into lines and finds the longest common
      subsequence between them. Lines outside that subsequence are reported as
      additions or removals, so you can see exactly what changed without any
      content leaving your browser. Switch to the unified view for the classic
      single-column diff.
    </p>
    <p class="text-sm leading-relaxed">
      JSON and XML are detected per side. JSON is re-serialised with the
      indentation you pick (two spaces, four spaces or tabs), which also
      normalises number formats and escapes. XML is re-indented only when the
      whole document is well-formed, and whitespace between elements is
      collapsed, so XML that relies on significant whitespace may show extra
      changes. Line numbers refer to the formatted text: turn the toggle off to
      compare exactly what you pasted.
    </p>
    <p class="text-sm leading-relaxed">
      Key order in JSON is not normalised, so two objects with the same keys in
      a different order still show as changes. Comparisons above a few thousand
      lines per side stop early to keep the tab responsive. Your text is kept in
      this tab, so a reload does not lose it, and it is cleared when you close
      the tab. Use Copy diff to paste the result somewhere else as plain - and +
      lines.
    </p>
  </section>

  <RelatedTools category="text" current={canonicalPath} />
</BaseLayout>

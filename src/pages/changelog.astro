---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CHANGELOG } from '../data/changelog';
import { accentClasses, findCategory } from '../data/site';
import { TOOLS } from '../data/tools';
import { formatChangelogDate, resolveChangelog } from '../lib/changelog';
import { breadcrumbs, collectionPage } from '../lib/jsonld';

const canonicalPath = '/changelog/';
const entries = resolveChangelog(CHANGELOG, TOOLS);

const jsonLd = [
  collectionPage({
    name: 'Changelog',
    description: 'New tools and improvements shipped to bajtools, newest first.',
    path: canonicalPath,
  }),
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Changelog', path: canonicalPath },
  ]),
];
---

<BaseLayout
  title="Changelog"
  description="Every new tool and improvement shipped to bajtools, newest first. Follow what changed and jump straight to the tool."
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
>
  <nav class="text-sm text-zinc-500 dark:text-zinc-400" aria-label="Breadcrumb">
    <a href="/" class="hover:text-zinc-900 dark:hover:text-zinc-100">Home</a>
    <span class="mx-2">/</span>
    <span>Changelog</span>
  </nav>

  <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">Changelog</h1>
  <p class="mt-3 max-w-xl text-zinc-600 dark:text-zinc-400">
    Every new tool and improvement, newest first. Follow what changed and jump
    straight to the tool.
  </p>

  <div class="mt-8">
    {
      entries.map((entry) => (
        <article
          id={`release-${entry.date}`}
          class="mt-8 border-t border-zinc-200 pt-6 first:mt-0 dark:border-zinc-800"
        >
          <h2 class="text-sm font-semibold uppercase tracking-wide text-zinc-500 dark:text-zinc-400">
            <time datetime={entry.date}>{formatChangelogDate(entry.date)}</time>
          </h2>

          {entry.notes.length > 0 && (
            <ul class="mt-3 max-w-2xl list-disc space-y-1 pl-5 text-sm text-zinc-600 dark:text-zinc-400">
              {entry.notes.map((note) => (
                <li>{note}</li>
              ))}
            </ul>
          )}

          {entry.tools.length > 0 && (
            <ul class="mt-4 flex flex-wrap gap-2">
              {entry.tools.map((tool) => {
                const category = findCategory(tool.category);
                const accent = accentClasses(category?.accent);
                return (
                  <li>
                    <a
                      href={tool.path}
                      class="inline-flex items-center gap-1.5 rounded-full border border-zinc-200 px-3 py-1 text-xs text-zinc-600 transition hover:border-zinc-400 hover:text-zinc-900 dark:border-zinc-800 dark:text-zinc-400 dark:hover:border-zinc-600 dark:hover:text-zinc-100"
                    >
                      <span class:list={['h-1.5 w-1.5 rounded-full', accent.bg]} aria-hidden="true" />
                      {tool.title}
                    </a>
                  </li>
                );
              })}
            </ul>
          )}
        </article>
      ))
    }
  </div>
</BaseLayout>

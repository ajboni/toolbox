---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DownloadTimeWidget from '../../components/DownloadTimeWidget.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import { breadcrumbs, webApplication } from '../../lib/jsonld';

const canonicalPath = '/networking/download-time/';

const jsonLd = [
  webApplication({
    name: 'Download Time Calculator',
    description:
      'Work out how long a file takes to download from its size and your connection speed.',
    path: canonicalPath,
  }),
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Networking', path: '/networking/' },
    { name: 'Download Time Calculator', path: canonicalPath },
  ]),
];
---

<BaseLayout
  title="Download Time Calculator · Size and Speed to Time"
  description="Find out how long a download takes from the file size and your connection speed. Handles bits and bytes, decimal and binary units, plus a table of common speeds."
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
>
  <nav class="text-sm text-zinc-500 dark:text-zinc-400" aria-label="Breadcrumb">
    <a href="/" class="hover:text-zinc-900 dark:hover:text-zinc-100">Home</a>
    <span class="mx-2">/</span>
    <a href="/networking/" class="hover:text-zinc-900 dark:hover:text-zinc-100">Networking</a>
    <span class="mx-2">/</span>
    <span>Download Time Calculator</span>
  </nav>

  <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
    Download time calculator
  </h1>
  <p class="mt-3 max-w-xl text-zinc-600 dark:text-zinc-400">
    Enter a file size and your connection speed to get the download time, plus a
    table showing the same file at common speeds. Everything runs in your browser
    and the values are stored in the URL.
  </p>

  <div class="mt-8">
    <DownloadTimeWidget accent="teal" />
  </div>

  <section class="mt-12 space-y-3 text-zinc-700 dark:text-zinc-300">
    <h2 class="text-xl font-semibold tracking-tight">How it works</h2>
    <p class="text-sm leading-relaxed">
      The file size is converted to bits, divided by the connection speed in bits
      per second, and the result is formatted as days, hours, minutes and seconds.
      Network speeds are usually quoted in bits per second (Mbit/s) while file
      sizes use bytes, so the calculator converts between both. This is the
      theoretical time: real transfers add protocol overhead and never reach the
      full advertised speed.
    </p>
  </section>

  <RelatedTools category="networking" current={canonicalPath} />
</BaseLayout>

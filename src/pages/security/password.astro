---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PasswordWidget from '../../components/PasswordWidget.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import { breadcrumbs, webApplication } from '../../lib/jsonld';

const canonicalPath = '/security/password/';

const jsonLd = [
  webApplication({
    name: 'Password & Passphrase Generator',
    description:
      'Generate strong random passwords or Diceware-style passphrases in your browser, with an entropy estimate.',
    path: canonicalPath,
  }),
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Security', path: '/security/' },
    { name: 'Password Generator', path: canonicalPath },
  ]),
];
---

<BaseLayout
  title="Password & Passphrase Generator"
  description="Generate strong random passwords or word-based passphrases right in your browser. Nothing is sent anywhere, and every setting is shareable via URL."
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
>
  <nav class="text-sm text-zinc-500 dark:text-zinc-400" aria-label="Breadcrumb">
    <a href="/" class="hover:text-zinc-900 dark:hover:text-zinc-100">Home</a>
    <span class="mx-2">/</span>
    <a href="/security/" class="hover:text-zinc-900 dark:hover:text-zinc-100">Security</a>
    <span class="mx-2">/</span>
    <span>Password Generator</span>
  </nav>

  <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
    Password &amp; passphrase generator
  </h1>
  <p class="mt-3 max-w-xl text-zinc-600 dark:text-zinc-400">
    Create strong random passwords or memorable word-based passphrases. Everything
    is generated locally with the Web Crypto API, so your secrets never leave
    your device and nothing is logged.
  </p>

  <div class="mt-8">
    <PasswordWidget accent="rose" />
  </div>

  <section class="mt-12 space-y-3 text-zinc-700 dark:text-zinc-300">
    <h2 class="text-xl font-semibold tracking-tight">How it works</h2>
    <p class="text-sm leading-relaxed">
      Passwords are built from the character sets you enable, guaranteeing at
      least one character from each. The strength meter estimates how many bits
      of entropy the result has, computed as the length times the base-2
      logarithm of the alphabet size. Passphrases follow the Diceware approach:
      each word is drawn from the 2048-word BIP-39 list, about 11 bits per word,
      so longer phrases are exponentially harder to guess. The optional digit is
      fused onto a random word, for example <code>harbor-cactus-7window-jacket</code>,
      which adds a few more bits without lengthening the phrase by a whole token.
    </p>
    <p class="text-sm leading-relaxed">
      The BIP-39 words are common and 3 to 8 letters long, each with a unique
      four-letter prefix, which makes the phrases easier to spell and remember.
      Randomness comes from the browser's cryptographic generator with rejection
      sampling to avoid modulo bias. The settings are encoded in the URL so you
      can share a recipe, but the generated password itself is never included.
    </p>
  </section>

  <section class="mt-8 text-sm text-zinc-600 dark:text-zinc-400">
    <p>
      Want a hash of a string instead? Try the
      <a href="/text/hash/" class="font-medium text-rose-600 hover:underline dark:text-rose-400">Hash Generator</a>.
    </p>
  </section>

  <RelatedTools category="security" current={canonicalPath} />
</BaseLayout>

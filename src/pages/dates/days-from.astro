---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DaysFromWidget from '../../components/DaysFromWidget.astro';
import { OFFSETS } from '../../data/offsets';
import { breadcrumbs, webApplication } from '../../lib/jsonld';

const canonicalPath = '/dates/days-from/';

const jsonLd = [
  webApplication({
    name: 'Days From Today Calculator',
    description:
      'Find the exact date a number of days from today or from any start date.',
    path: canonicalPath,
  }),
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Dates & Time', path: '/dates/' },
    { name: 'Days From Today', path: canonicalPath },
  ]),
];
---

<BaseLayout
  title="Days From Today Calculator · What Date Is X Days From Now?"
  description="Find the exact date a number of days from today or from any start date, including the weekday. Free, instant and shareable. No sign-up required."
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
>
  <nav class="text-sm text-zinc-500 dark:text-zinc-400" aria-label="Breadcrumb">
    <a href="/" class="hover:text-zinc-900 dark:hover:text-zinc-100">Home</a>
    <span class="mx-2">/</span>
    <a href="/dates/" class="hover:text-zinc-900 dark:hover:text-zinc-100">Dates &amp; Time</a>
    <span class="mx-2">/</span>
    <span>Days From Today</span>
  </nav>

  <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
    What date is X days from today?
  </h1>
  <p class="mt-3 max-w-xl text-zinc-600 dark:text-zinc-400">
    Pick a start date (today by default) and a number of days, and see the exact
    date it lands on. Negative numbers count backwards. Your inputs are stored
    in the URL, so you can copy the link and share the exact result.
  </p>

  <div class="mt-8">
    <DaysFromWidget mode="picker" />
  </div>

  <section class="mt-12 space-y-3 text-zinc-700 dark:text-zinc-300">
    <h2 class="text-xl font-semibold tracking-tight">How it works</h2>
    <p class="text-sm leading-relaxed">
      The calculator adds the number of days you enter to the start date,
      counting whole calendar days. It reports the resulting date, its weekday,
      and how the gap breaks down into weeks and months. Use a negative number
      to look backwards instead of forwards.
    </p>
  </section>

  <section class="mt-12">
    <h2 class="text-xl font-semibold tracking-tight">Quick answers</h2>
    <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">
      Common offsets from today, each with its own page.
    </p>
    <ul class="mt-4 flex flex-wrap gap-2">
      {
        OFFSETS.map((offset) => (
          <li>
            <a
              href={`/dates/days-from/${offset.slug}/`}
              class="inline-block rounded-full border border-zinc-300 px-4 py-1.5 text-sm transition hover:border-zinc-500 dark:border-zinc-700 dark:hover:border-zinc-500"
            >
              {offset.label} from today
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-12 text-sm">
    <a
      href="/dates/days-until/"
      class="text-zinc-600 underline hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100"
    >
      Counting down to a date instead? Try Days Until →
    </a>
  </section>
</BaseLayout>

---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DaysUntilWidget from '../../../components/DaysUntilWidget.astro';
import { OCCASIONS, type Occasion } from '../../../data/occasions';
import { breadcrumbs, webApplication } from '../../../lib/jsonld';

export const getStaticPaths: GetStaticPaths = () => {
  return OCCASIONS.map((occasion) => ({
    params: { occasion: occasion.slug },
    props: { occasion },
  }));
};

interface Props {
  occasion: Occasion;
}

const { occasion } = Astro.props;
const canonicalPath = `/dates/days-until/${occasion.slug}/`;
const others = OCCASIONS.filter((item) => item.slug !== occasion.slug);

const jsonLd = [
  webApplication({
    name: `Days Until ${occasion.name}`,
    description: occasion.seoDescription,
    path: canonicalPath,
  }),
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Dates & Time', path: '/dates/' },
    { name: 'Days Until', path: '/dates/days-until/' },
    { name: occasion.name, path: canonicalPath },
  ]),
];
---

<BaseLayout
  title={occasion.seoTitle}
  description={occasion.seoDescription}
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
>
  <nav class="text-sm text-zinc-500 dark:text-zinc-400" aria-label="Breadcrumb">
    <a href="/" class="hover:text-zinc-900 dark:hover:text-zinc-100">Home</a>
    <span class="mx-2">/</span>
    <a href="/dates/" class="hover:text-zinc-900 dark:hover:text-zinc-100">Dates &amp; Time</a>
    <span class="mx-2">/</span>
    <a href="/dates/days-until/" class="hover:text-zinc-900 dark:hover:text-zinc-100">Days Until</a>
    <span class="mx-2">/</span>
    <span>{occasion.shortName}</span>
  </nav>

  <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
    How many days until {occasion.shortName}?
  </h1>
  <p class="mt-3 max-w-xl text-zinc-600 dark:text-zinc-400">
    {occasion.intro}
  </p>

  <div class="mt-8">
    <DaysUntilWidget mode="annual" month={occasion.month} day={occasion.day} />
  </div>

  <section class="mt-12 space-y-3 text-zinc-700 dark:text-zinc-300">
    <h2 class="text-xl font-semibold tracking-tight">
      About this {occasion.shortName} countdown
    </h2>
    <p class="text-sm leading-relaxed">{occasion.about}</p>
  </section>

  <section class="mt-12">
    <h2 class="text-xl font-semibold tracking-tight">Other countdowns</h2>
    <ul class="mt-4 flex flex-wrap gap-2">
      {
        others.map((item) => (
          <li>
            <a
              href={`/dates/days-until/${item.slug}/`}
              class="inline-block rounded-full border border-zinc-300 px-4 py-1.5 text-sm transition hover:border-zinc-500 dark:border-zinc-700 dark:hover:border-zinc-500"
            >
              Days until {item.shortName}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="mt-6 text-sm">
      <a
        href="/dates/days-until/"
        class="text-zinc-600 underline hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100"
      >
        Count down to any other date →
      </a>
    </p>
  </section>
</BaseLayout>

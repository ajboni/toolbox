---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DaysFromWidget from '../../../components/DaysFromWidget.astro';
import { OFFSETS, type Offset } from '../../../data/offsets';
import { breadcrumbs, webApplication } from '../../../lib/jsonld';

export const getStaticPaths: GetStaticPaths = () => {
  return OFFSETS.map((offset) => ({
    params: { offset: offset.slug },
    props: { offset },
  }));
};

interface Props {
  offset: Offset;
}

const { offset } = Astro.props;
const canonicalPath = `/dates/days-from/${offset.slug}/`;
const others = OFFSETS.filter((item) => item.slug !== offset.slug);

const jsonLd = [
  webApplication({
    name: `What Is ${offset.days} Days From Today?`,
    description: offset.seoDescription,
    path: canonicalPath,
  }),
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Dates & Time', path: '/dates/' },
    { name: 'Days From Today', path: '/dates/days-from/' },
    { name: `${offset.days} Days`, path: canonicalPath },
  ]),
];
---

<BaseLayout
  title={offset.seoTitle}
  description={offset.seoDescription}
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
>
  <nav class="text-sm text-zinc-500 dark:text-zinc-400" aria-label="Breadcrumb">
    <a href="/" class="hover:text-zinc-900 dark:hover:text-zinc-100">Home</a>
    <span class="mx-2">/</span>
    <a href="/dates/" class="hover:text-zinc-900 dark:hover:text-zinc-100">Dates &amp; Time</a>
    <span class="mx-2">/</span>
    <a href="/dates/days-from/" class="hover:text-zinc-900 dark:hover:text-zinc-100">Days From Today</a>
    <span class="mx-2">/</span>
    <span>{offset.label}</span>
  </nav>

  <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
    What is {offset.label} from today?
  </h1>
  <p class="mt-3 max-w-xl text-zinc-600 dark:text-zinc-400">
    {offset.intro}
  </p>

  <div class="mt-8">
    <DaysFromWidget mode="offset" days={offset.days} />
  </div>

  <section class="mt-12 space-y-3 text-zinc-700 dark:text-zinc-300">
    <h2 class="text-xl font-semibold tracking-tight">
      How this {offset.label} calculation works
    </h2>
    <p class="text-sm leading-relaxed">{offset.about}</p>
  </section>

  <section class="mt-12">
    <h2 class="text-xl font-semibold tracking-tight">Other offsets</h2>
    <ul class="mt-4 flex flex-wrap gap-2">
      {
        others.map((item) => (
          <li>
            <a
              href={`/dates/days-from/${item.slug}/`}
              class="inline-block rounded-full border border-zinc-300 px-4 py-1.5 text-sm transition hover:border-zinc-500 dark:border-zinc-700 dark:hover:border-zinc-500"
            >
              {item.label} from today
            </a>
          </li>
        ))
      }
    </ul>
    <p class="mt-6 text-sm">
      <a
        href="/dates/days-from/"
        class="text-zinc-600 underline hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100"
      >
        Calculate a different number of days →
      </a>
    </p>
  </section>
</BaseLayout>

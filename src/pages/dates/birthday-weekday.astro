---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BirthdayWeekdayWidget from '../../components/BirthdayWeekdayWidget.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import { breadcrumbs, webApplication } from '../../lib/jsonld';

const canonicalPath = '/dates/birthday-weekday/';

const jsonLd = [
  webApplication({
    name: 'Birthday Weekday',
    description:
      'See which day of the week every one of your birthdays falls on, past and future.',
    path: canonicalPath,
  }),
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Dates & Time', path: '/dates/' },
    { name: 'Birthday Weekday', path: canonicalPath },
  ]),
];
---

<BaseLayout
  title="Birthday Weekday · What Day Is Your Birthday?"
  description="Enter your date of birth to see which day of the week every birthday falls on, past and future, plus how often each weekday comes up. Free and shareable."
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
>
  <nav class="text-sm text-zinc-500 dark:text-zinc-400" aria-label="Breadcrumb">
    <a href="/" class="hover:text-zinc-900 dark:hover:text-zinc-100">Home</a>
    <span class="mx-2">/</span>
    <a href="/dates/" class="hover:text-zinc-900 dark:hover:text-zinc-100">Dates &amp; Time</a>
    <span class="mx-2">/</span>
    <span>Birthday Weekday</span>
  </nav>

  <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
    What day of the week is your birthday?
  </h1>
  <p class="mt-3 max-w-xl text-zinc-600 dark:text-zinc-400">
    Pick your date of birth and the tool lists the weekday for every birthday,
    from the year you were born up to your hundredth, then tallies how often
    each day comes up. Your date is stored in the URL, so you can copy the link
    and share the full list.
  </p>

  <div class="mt-8">
    <BirthdayWeekdayWidget accent="violet" />
  </div>

  <section class="mt-12 space-y-3 text-zinc-700 dark:text-zinc-300">
    <h2 class="text-xl font-semibold tracking-tight">How it works</h2>
    <p class="text-sm leading-relaxed">
      Each birthday is built from the month and day of your birth date and the
      calendar year, and the weekday comes straight from the Gregorian
      calendar. The table starts at your birth year and runs for one hundred
      birthdays, with the current year and the next one highlighted.
    </p>
    <p class="text-sm leading-relaxed">
      If you were born on 29 February, the tool treats the birthday as 28
      February in non-leap years, so every year still counts. Because a year is
      365 or 366 days, the weekday shifts by one or two days each year, which is
      why the tally is rarely even across all seven days.
    </p>
  </section>

  <RelatedTools category="dates" current={canonicalPath} />
</BaseLayout>

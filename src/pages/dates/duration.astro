---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DurationWidget from '../../components/DurationWidget.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import { breadcrumbs, webApplication } from '../../lib/jsonld';

const canonicalPath = '/dates/duration/';

const jsonLd = [
  webApplication({
    name: 'Date Duration Calculator',
    description: 'Measure the time between two dates in years, months, days and weeks.',
    path: canonicalPath,
  }),
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Dates & Time', path: '/dates/' },
    { name: 'Date Duration', path: canonicalPath },
  ]),
];
---

<BaseLayout
  title="Date Duration Calculator · Time Between Two Dates"
  description="Find the exact time between two dates in years, months, days, weeks and hours. Works backwards, free and shareable."
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
>
  <nav class="text-sm text-zinc-500 dark:text-zinc-400" aria-label="Breadcrumb">
    <a href="/" class="hover:text-zinc-900 dark:hover:text-zinc-100">Home</a>
    <span class="mx-2">/</span>
    <a href="/dates/" class="hover:text-zinc-900 dark:hover:text-zinc-100">Dates &amp; Time</a>
    <span class="mx-2">/</span>
    <span>Date Duration</span>
  </nav>

  <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
    Time between two dates
  </h1>
  <p class="mt-3 max-w-xl text-zinc-600 dark:text-zinc-400">
    Pick a start and end date to see the exact gap in years, months and days,
    plus the same span as total days, weeks and hours. The inputs live in the URL,
    so the calculation is easy to share.
  </p>

  <div class="mt-8">
    <DurationWidget accent="violet" />
  </div>

  <section class="mt-12 space-y-3 text-zinc-700 dark:text-zinc-300">
    <h2 class="text-xl font-semibold tracking-tight">How it works</h2>
    <p class="text-sm leading-relaxed">
      The result counts full calendar years, then full months, then leftover
      days. Swap the two dates and the range is treated as backwards, but the
      totals stay positive. All calculations use whole days, ignoring the time
      of day.
    </p>
  </section>

  <RelatedTools category="dates" current={canonicalPath} />
</BaseLayout>

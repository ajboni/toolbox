---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DaysUntilWidget from '../../components/DaysUntilWidget.astro';
import { OCCASIONS } from '../../data/occasions';
import { breadcrumbs, webApplication } from '../../lib/jsonld';

const canonicalPath = '/dates/days-until/';

const jsonLd = [
  webApplication({
    name: 'Days Until Calculator',
    description:
      'Pick any date and instantly see how many days, weeks and months are left until it.',
    path: canonicalPath,
  }),
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Dates & Time', path: '/dates/' },
    { name: 'Days Until', path: canonicalPath },
  ]),
];
---

<BaseLayout
  title="Days Until Calculator — Count Down to Any Date"
  description="Pick any date and instantly see how many days, weeks and months are left until it. Free, fast and shareable — no sign-up required."
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
>
  <nav class="text-sm text-zinc-500 dark:text-zinc-400" aria-label="Breadcrumb">
    <a href="/" class="hover:text-zinc-900 dark:hover:text-zinc-100">Home</a>
    <span class="mx-2">/</span>
    <a href="/dates/" class="hover:text-zinc-900 dark:hover:text-zinc-100">Dates &amp; Time</a>
    <span class="mx-2">/</span>
    <span>Days Until</span>
  </nav>

  <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
    How many days until…?
  </h1>
  <p class="mt-3 max-w-xl text-zinc-600 dark:text-zinc-400">
    Choose a date below and the counter updates instantly. Your selection is
    saved in the URL, so you can copy the link and share the exact countdown.
  </p>

  <div class="mt-8">
    <DaysUntilWidget mode="picker" />
  </div>

  <section class="mt-12 space-y-3 text-zinc-700 dark:text-zinc-300">
    <h2 class="text-xl font-semibold tracking-tight">How it works</h2>
    <p class="text-sm leading-relaxed">
      The countdown compares today's date with your chosen date at local
      midnight, then reports the difference in whole days. Weeks, remainder days
      and an approximate month figure are shown as well. Past dates are reported
      as "days ago" instead of a negative number.
    </p>
  </section>

  <section class="mt-12">
    <h2 class="text-xl font-semibold tracking-tight">Popular countdowns</h2>
    <ul class="mt-4 flex flex-wrap gap-2">
      {
        OCCASIONS.map((occasion) => (
          <li>
            <a
              href={`/dates/days-until/${occasion.slug}/`}
              class="inline-block rounded-full border border-zinc-300 px-4 py-1.5 text-sm transition hover:border-zinc-500 dark:border-zinc-700 dark:hover:border-zinc-500"
            >
              Days until {occasion.shortName}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-12 text-sm">
    <a
      href="/dates/days-from/"
      class="text-zinc-600 underline hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100"
    >
      Need the opposite? Find the date X days from today →
    </a>
  </section>
</BaseLayout>

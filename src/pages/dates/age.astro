---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AgeWidget from '../../components/AgeWidget.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import { breadcrumbs, webApplication } from '../../lib/jsonld';

const canonicalPath = '/dates/age/';

const jsonLd = [
  webApplication({
    name: 'Age Calculator',
    description:
      'Work out your exact age in years, months and days from any date of birth.',
    path: canonicalPath,
  }),
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Dates & Time', path: '/dates/' },
    { name: 'Age Calculator', path: canonicalPath },
  ]),
];
---

<BaseLayout
  title="Age Calculator · How Old Am I?"
  description="Enter a date of birth to get your exact age in years, months and days, plus total days and a countdown to your next birthday. Free and shareable."
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
>
  <nav class="text-sm text-zinc-500 dark:text-zinc-400" aria-label="Breadcrumb">
    <a href="/" class="hover:text-zinc-900 dark:hover:text-zinc-100">Home</a>
    <span class="mx-2">/</span>
    <a href="/dates/" class="hover:text-zinc-900 dark:hover:text-zinc-100">Dates &amp; Time</a>
    <span class="mx-2">/</span>
    <span>Age Calculator</span>
  </nav>

  <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
    How old am I?
  </h1>
  <p class="mt-3 max-w-xl text-zinc-600 dark:text-zinc-400">
    Pick a date of birth and a reference date (today by default) to get the exact
    age in years, months and days. The result is stored in the URL, so you can
    copy the link and share the exact calculation.
  </p>

  <div class="mt-8">
    <AgeWidget accent="violet" />
  </div>

  <section class="mt-12 space-y-3 text-zinc-700 dark:text-zinc-300">
    <h2 class="text-xl font-semibold tracking-tight">How it works</h2>
    <p class="text-sm leading-relaxed">
      The calculator counts full calendar years, then full months, then the
      remaining days between the two dates. Leap-day birthdays are clamped to the
      last day of February in non-leap years, so someone born on 29 February
      still has a birthday every year.
    </p>
  </section>

  <RelatedTools category="dates" current={canonicalPath} />
</BaseLayout>

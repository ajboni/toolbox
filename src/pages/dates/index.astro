---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolCard from '../../components/ToolCard.astro';
import { CATEGORIES } from '../../data/site';
import { toolsInCategory } from '../../data/tools';
import { OCCASIONS } from '../../data/occasions';
import { OFFSETS } from '../../data/offsets';
import { breadcrumbs, webApplication } from '../../lib/jsonld';

const category = CATEGORIES.find((item) => item.slug === 'dates')!;
const tools = toolsInCategory('dates');
const canonicalPath = '/dates/';

const jsonLd = [
  webApplication({
    name: category.name,
    description: category.description,
    path: canonicalPath,
  }),
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: category.name, path: canonicalPath },
  ]),
];
---

<BaseLayout
  title={category.name}
  description={`${category.description} Free, instant and no sign-up required.`}
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
>
  <nav class="text-sm text-zinc-500 dark:text-zinc-400" aria-label="Breadcrumb">
    <a href="/" class="hover:text-zinc-900 dark:hover:text-zinc-100">Home</a>
    <span class="mx-2">/</span>
    <span>{category.name}</span>
  </nav>

  <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
    {category.name}
  </h1>
  <p class="mt-3 max-w-xl text-zinc-600 dark:text-zinc-400">
    {category.description}
  </p>

  <section class="mt-8 grid gap-4 sm:grid-cols-2">
    {
      tools.map((tool) => (
        <ToolCard
          title={tool.title}
          description={tool.description}
          href={tool.path}
          accent={category.accent}
        />
      ))
    }
  </section>

  <section class="mt-12">
    <h2 class="text-xl font-semibold tracking-tight">Countdowns to common dates</h2>
    <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">
      Jump straight to a ready-made countdown. Each page updates automatically.
    </p>
    <ul class="mt-4 flex flex-wrap gap-2">
      {
        OCCASIONS.map((occasion) => (
          <li>
            <a
              href={`/dates/days-until/${occasion.slug}/`}
              class="inline-block rounded-full border border-zinc-300 px-4 py-1.5 text-sm transition hover:border-zinc-500 dark:border-zinc-700 dark:hover:border-zinc-500"
            >
              Days until {occasion.shortName}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-12">
    <h2 class="text-xl font-semibold tracking-tight">Dates from today</h2>
    <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">
      Common offsets forward from today, each recalculated on load.
    </p>
    <ul class="mt-4 flex flex-wrap gap-2">
      {
        OFFSETS.map((offset) => (
          <li>
            <a
              href={`/dates/days-from/${offset.slug}/`}
              class="inline-block rounded-full border border-zinc-300 px-4 py-1.5 text-sm transition hover:border-zinc-500 dark:border-zinc-700 dark:hover:border-zinc-500"
            >
              {offset.label} from today
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

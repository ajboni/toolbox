---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolCard from '../components/ToolCard.astro';
import { CATEGORIES, SITE } from '../data/site';
import { toolsInCategory } from '../data/tools';
import { breadcrumbs, webApplication } from '../lib/jsonld';

const jsonLd = [
  webApplication({
    name: SITE.name,
    description: SITE.description,
    path: '/',
  }),
  breadcrumbs([{ name: 'Home', path: '/' }]),
];
---

<BaseLayout
  title={`${SITE.name} — Small, fast web tools`}
  description={SITE.description}
  canonicalPath="/"
  jsonLd={jsonLd}
>
  <section>
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{SITE.name}</h1>
    <p class="mt-4 max-w-xl text-slate-600 dark:text-slate-400">
      {SITE.tagline} Every tool lives on its own page — open it, get your answer,
      close it. No accounts, no clutter.
    </p>
  </section>

  <section class="mt-12 space-y-10">
    {
      CATEGORIES.map((category) => {
        const tools = toolsInCategory(category.slug);
        return (
          <div>
            <div class="flex items-baseline justify-between gap-4">
              <h2 class="text-xl font-semibold tracking-tight">
                <a href={`/${category.slug}/`} class="hover:opacity-80">
                  {category.name}
                </a>
              </h2>
              <a
                href={`/${category.slug}/`}
                class="text-sm text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100"
              >
                View all
              </a>
            </div>
            <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
              {category.description}
            </p>
            {tools.length > 0 ? (
              <div class="mt-4 grid gap-4 sm:grid-cols-2">
                {tools.map((tool) => (
                  <ToolCard
                    title={tool.title}
                    description={tool.description}
                    href={tool.path}
                  />
                ))}
              </div>
            ) : (
              <p class="mt-3 text-sm text-slate-500 dark:text-slate-500">
                More tools coming soon.
              </p>
            )}
          </div>
        );
      })
    }
  </section>
</BaseLayout>

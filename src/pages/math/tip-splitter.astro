---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TipWidget from '../../components/TipWidget.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import { breadcrumbs, webApplication } from '../../lib/jsonld';

const canonicalPath = '/math/tip-splitter/';

const jsonLd = [
  webApplication({
    name: 'Tip Calculator and Bill Splitter',
    description: 'Work out the tip, the total and how much everyone pays.',
    path: canonicalPath,
  }),
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Math & Numbers', path: '/math/' },
    { name: 'Tip Splitter', path: canonicalPath },
  ]),
];
---

<BaseLayout
  title="Tip Calculator · Split the Bill Fairly"
  description="Add a tip percentage to any bill and split the total between any number of people. Free, instant and shareable via URL."
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
>
  <nav class="text-sm text-zinc-500 dark:text-zinc-400" aria-label="Breadcrumb">
    <a href="/" class="hover:text-zinc-900 dark:hover:text-zinc-100">Home</a>
    <span class="mx-2">/</span>
    <a href="/math/" class="hover:text-zinc-900 dark:hover:text-zinc-100">Math &amp; Numbers</a>
    <span class="mx-2">/</span>
    <span>Tip Splitter</span>
  </nav>

  <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
    Tip calculator and bill splitter
  </h1>
  <p class="mt-3 max-w-xl text-zinc-600 dark:text-zinc-400">
    Enter the bill, choose a tip percentage and say how many people are paying.
    You get the tip, the grand total and the amount each person owes. Your inputs
    are saved in the URL so you can share the exact split.
  </p>

  <div class="mt-8">
    <TipWidget accent="emerald" />
  </div>

  <section class="mt-12 space-y-3 text-zinc-700 dark:text-zinc-300">
    <h2 class="text-xl font-semibold tracking-tight">How it works</h2>
    <p class="text-sm leading-relaxed">
      The tip is the bill multiplied by the tip percentage. The total is the bill
      plus the tip. To split, divide both the total and the tip by the number of
      people. Amounts are shown in US dollars and rounded to the cent.
    </p>
  </section>

  <RelatedTools category="math" current={canonicalPath} />
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PercentWidget from '../../components/PercentWidget.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import { breadcrumbs, webApplication } from '../../lib/jsonld';

const canonicalPath = '/math/rule-of-three/';

const jsonLd = [
  webApplication({
    name: 'Rule of Three Calculator',
    description:
      'Solve any proportion a / b = c / x for the missing value and share the result with a link.',
    path: canonicalPath,
  }),
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Math & Numbers', path: '/math/' },
    { name: 'Rule of Three', path: canonicalPath },
  ]),
];
---

<BaseLayout
  title="Rule of Three Calculator · Solve Proportions (a/b = c/x)"
  description="Solve the rule of three: find the missing value in a proportion a / b = c / x. Choose which value to solve for. Free and shareable."
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
>
  <nav class="text-sm text-zinc-500 dark:text-zinc-400" aria-label="Breadcrumb">
    <a href="/" class="hover:text-zinc-900 dark:hover:text-zinc-100">Home</a>
    <span class="mx-2">/</span>
    <a href="/math/" class="hover:text-zinc-900 dark:hover:text-zinc-100">Math &amp; Numbers</a>
    <span class="mx-2">/</span>
    <span>Rule of Three</span>
  </nav>

  <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
    Rule of three
  </h1>
  <p class="mt-3 max-w-xl text-zinc-600 dark:text-zinc-400">
    Solve a simple proportion where A is to B as C is to X. Pick which of the
    four values is unknown and the rest are filled in for you.
  </p>

  <div class="mt-8">
    <PercentWidget mode="rule-of-three" accent="emerald" />
  </div>

  <section class="mt-12 space-y-3 text-zinc-700 dark:text-zinc-300">
    <h2 class="text-xl font-semibold tracking-tight">How it works</h2>
    <p class="text-sm leading-relaxed">
      The rule of three keeps a ratio constant: A ÷ B = C ÷ X. When X is the
      unknown, X = (B × C) ÷ A. The same relation is rearranged to solve for A,
      B or C. Percentages are a special case where one side is out of 100. For
      that, use the "what percent" tool.
    </p>
  </section>

  <RelatedTools category="math" current={canonicalPath} />
</BaseLayout>

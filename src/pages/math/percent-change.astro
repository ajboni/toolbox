---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PercentWidget from '../../components/PercentWidget.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import { breadcrumbs, webApplication } from '../../lib/jsonld';

const canonicalPath = '/math/percent-change/';

const jsonLd = [
  webApplication({
    name: 'Percentage Change Calculator',
    description:
      'Measure the percentage increase or decrease between two values and share the result with a link.',
    path: canonicalPath,
  }),
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Math & Numbers', path: '/math/' },
    { name: 'Percentage Change', path: canonicalPath },
  ]),
];
---

<BaseLayout
  title="Percentage Change Calculator — Increase or Decrease"
  description="Measure the percentage increase or decrease between two values. Enter a starting value and an ending value to get the change instantly."
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
>
  <nav class="text-sm text-zinc-500 dark:text-zinc-400" aria-label="Breadcrumb">
    <a href="/" class="hover:text-zinc-900 dark:hover:text-zinc-100">Home</a>
    <span class="mx-2">/</span>
    <a href="/math/" class="hover:text-zinc-900 dark:hover:text-zinc-100">Math &amp; Numbers</a>
    <span class="mx-2">/</span>
    <span>Percentage Change</span>
  </nav>

  <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
    Percentage change
  </h1>
  <p class="mt-3 max-w-xl text-zinc-600 dark:text-zinc-400">
    Compare two values and see the change as a percentage. A positive result is
    an increase, a negative result is a decrease.
  </p>

  <div class="mt-8">
    <PercentWidget mode="change" accent="emerald" />
  </div>

  <section class="mt-12 space-y-3 text-zinc-700 dark:text-zinc-300">
    <h2 class="text-xl font-semibold tracking-tight">How it works</h2>
    <p class="text-sm leading-relaxed">
      Subtract the starting value from the ending value, divide by the starting
      value, then multiply by 100. For example, going from 100 to 125 is
      ((125 − 100) ÷ 100) × 100 = +25%.
    </p>
  </section>

  <RelatedTools category="math" current={canonicalPath} />
</BaseLayout>

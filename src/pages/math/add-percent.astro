---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PercentWidget from '../../components/PercentWidget.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import { breadcrumbs, webApplication } from '../../lib/jsonld';

const canonicalPath = '/math/add-percent/';

const jsonLd = [
  webApplication({
    name: 'Add or Subtract a Percentage Calculator',
    description:
      'Increase or decrease a value by a percentage in one step and share the result with a link.',
    path: canonicalPath,
  }),
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Math & Numbers', path: '/math/' },
    { name: 'Add or Subtract a Percentage', path: canonicalPath },
  ]),
];
---

<BaseLayout
  title="Add or Subtract a Percentage · Percentage Calculator"
  description="Increase or decrease a value by a percentage in one step. Handy for markups, discounts, taxes and tips. Free and shareable."
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
>
  <nav class="text-sm text-zinc-500 dark:text-zinc-400" aria-label="Breadcrumb">
    <a href="/" class="hover:text-zinc-900 dark:hover:text-zinc-100">Home</a>
    <span class="mx-2">/</span>
    <a href="/math/" class="hover:text-zinc-900 dark:hover:text-zinc-100">Math &amp; Numbers</a>
    <span class="mx-2">/</span>
    <span>Add or Subtract a Percentage</span>
  </nav>

  <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
    Add or subtract a percentage
  </h1>
  <p class="mt-3 max-w-xl text-zinc-600 dark:text-zinc-400">
    Increase a value by a percentage (like adding tax) or decrease it (like
    applying a discount) and see the new total immediately.
  </p>

  <div class="mt-8">
    <PercentWidget mode="add-subtract" accent="emerald" />
  </div>

  <section class="mt-12 space-y-3 text-zinc-700 dark:text-zinc-300">
    <h2 class="text-xl font-semibold tracking-tight">How it works</h2>
    <p class="text-sm leading-relaxed">
      To add a percentage, multiply the value by (1 + percentage ÷ 100). To
      subtract, multiply by (1 − percentage ÷ 100). For example, 1,000 plus 21%
      is 1,000 × 1.21 = 1,210, and 1,000 minus 15% is 1,000 × 0.85 = 850.
    </p>
  </section>

  <RelatedTools category="math" current={canonicalPath} />
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found"
  description="The page you were looking for does not exist."
  canonicalPath="/404/"
  noindex={true}
>
  <h1 class="text-3xl font-bold tracking-tight">404 — Page not found</h1>
  <p class="mt-3 text-slate-600 dark:text-slate-400">
    That tool does not exist (yet). Head back to the homepage to see what is
    available.
  </p>
  <p class="mt-6">
    <a
      href="/"
      class="inline-block rounded-full border border-slate-300 px-4 py-2 text-sm font-medium transition hover:border-slate-500 dark:border-slate-700 dark:hover:border-slate-500"
    >
      Back to home
    </a>
  </p>
</BaseLayout>
